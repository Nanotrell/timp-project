# ============================================================================
# DOXYFILE ДЛЯ ПРОЕКТА "РАЗРАБОТКА ПРИЛОЖЕНИЯ КЛИЕНТ-СЕРВЕР"
# ============================================================================

# ----------------------------------------------------------------------------
# Основные настройки
# ----------------------------------------------------------------------------
PROJECT_NAME           = "Разработка приложения клиент-сервер"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Клиент-серверное приложение для построения графиков математических функций"
OUTPUT_DIRECTORY       = ./docs
OUTPUT_LANGUAGE        = Russian
RECURSIVE              = YES

# ----------------------------------------------------------------------------
# Входные файлы (сервер и клиент)
# ----------------------------------------------------------------------------
INPUT                  = ./server \
                         ./client
FILE_PATTERNS          = *.cpp *.h
EXCLUDE_PATTERNS       = */moc_* */build/* */.git/*

# ----------------------------------------------------------------------------
# Извлечение информации
# ----------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ----------------------------------------------------------------------------
# Визуализация (диаграммы)
# ----------------------------------------------------------------------------
HAVE_DOT               = YES
UML_LOOK               = YES
CLASS_DIAGRAMS         = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
INTERACTIVE_SVG        = YES

# ----------------------------------------------------------------------------
# HTML настройки
# ----------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE_HUE    = 210
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES

# ----------------------------------------------------------------------------
# Прочие форматы (отключаем для ускорения)
# ----------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ----------------------------------------------------------------------------
# Настройки исходников
# ----------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ----------------------------------------------------------------------------
# Кодировка
# ----------------------------------------------------------------------------
INPUT_ENCODING         = UTF-8

# ----------------------------------------------------------------------------
# Оптимизация
# ----------------------------------------------------------------------------
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 5
DOT_CLEANUP            = YES
