# Название проекта
PROJECT_NAME           = "Function Plotter"

# Версия
PROJECT_NUMBER         = 1.0

# Входные директории (где искать код)
INPUT                  = ./server ./client

# Рекурсивно обходить поддиректории
RECURSIVE              = YES

# Какие файлы обрабатывать
FILE_PATTERNS          = *.cpp *.h

# Выходная директория
OUTPUT_DIRECTORY       = ./docs

# Генерировать HTML
GENERATE_HTML          = YES

# Генерировать диаграммы (нужен graphviz)
HAVE_DOT               = YES

# Включить всё (включая приватные методы)
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Включить поиск
SEARCHENGINE           = YES
